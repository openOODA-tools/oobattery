// # oobattery Render Subsystem Anchor
//
// Logline: Consolidates charge gauges, power diagnostics, ANSI styling, and JSON envelopes.
//
// Setup: Root barrel shim for render formatting domain.
//
// Beats:
//   1. Re-export ANSI terminal color styling.
//   2. Re-export battery percentage gauges and text summaries.
//   3. Re-export JSON serializers for power supply records.

import "render/battery_theme.oo";

pub fn render_subsystem_version() -> String {
    return "0.2.0";
}

pub fn render_subsystem_description() -> String {
    return "oobattery pure openOODA render and JSON serialization subsystem";
}
